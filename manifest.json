{
  "manifest_version": 3,
  "name": "Better GHSA",
  "version": "0.0.2",
  "description": "Triage state for GitHub security advisories, kept in a comment on the advisory.",
  "icons": {
    "16": "src/icons/icon-16.png",
    "32": "src/icons/icon-32.png",
    "48": "src/icons/icon-48.png",
    "64": "src/icons/icon-64.png",
    "128": "src/icons/icon-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://github.com/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; upgrade-insecure-requests; frame-ancestors 'none'"
  },
  "options_ui": {
    "page": "src/settings/settings.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": [
        "src/common/dom.js",
        "src/common/text.js",
        "src/common/storage.js",
        "src/common/allowlist.js",
        "src/common/settings-control.js",
        "src/common/trust.js",
        "src/common/schema.js",
        "src/common/merge.js",
        "src/common/parse-detail.js",
        "src/common/parse-list.js",
        "src/common/record.js",
        "src/common/derive.js",
        "src/common/order.js",
        "src/common/chips.js",
        "src/common/row.js",
        "src/common/duplicate.js",
        "src/common/members.js",
        "src/common/branches.js",
        "src/common/cache.js",
        "src/common/write.js",
        "src/common/fetch.js",
        "src/common/crawl.js",
        "src/detail/tracking.js",
        "src/detail/comments.js",
        "src/detail/preserve.js",
        "src/detail/state.js",
        "src/detail/edit.js",
        "src/detail/panel.js",
        "src/list/table.js",
        "src/done/corpus.js",
        "src/done/stats.js",
        "src/done/csv.js",
        "src/done/view.js",
        "src/stats/statistics.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/settings/settings.html"],
      "matches": ["https://github.com/*"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "better-ghsa@sbk.wtf",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
